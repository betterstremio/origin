/* Origin.exe's resources: the manifest (1 = the one Windows reads at start, 24 = RT_MANIFEST), the icon (made from
   assets/icon.png by tools/targets/windows.sh) and the version Explorer shows (VER_* from the VERSION file). */
#include <winver.h>
1 24 "origin.manifest"
1 ICON "origin.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_A,VER_B,VER_C,0
 PRODUCTVERSION VER_A,VER_B,VER_C,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Origin"
      VALUE "FileVersion", VER_STR
      VALUE "InternalName", "Origin"
      VALUE "OriginalFilename", "Origin.exe"
      VALUE "ProductName", "Origin"
      VALUE "ProductVersion", VER_STR
      VALUE "LegalCopyright", "GPL-3.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
